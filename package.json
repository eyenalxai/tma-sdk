{
  "name": "@eyenalxai/tma-sdk",
  "version": "0.1.1",
  "description": "TypeScript SDK for Telegram Mini Apps with React bindings and server init-data validation.",
  "keywords": [
    "mini-app",
    "react",
    "sdk",
    "telegram",
    "telegram-mini-app",
    "telegram-mini-apps",
    "typescript"
  ],
  "homepage": "https://github.com/eyenalxai/tma-sdk#readme",
  "bugs": {
    "url": "https://github.com/eyenalxai/tma-sdk/issues"
  },
  "license": "MIT",
  "author": "Sax Dhiut <mail@iyxeyl.me>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eyenalxai/tma-sdk.git"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "default": "./dist/react.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun test && bun run build && bun run lint:package",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "lint:package": "publint && attw --pack . --profile esm-only",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check",
    "release": "changeset publish",
    "typecheck": "tsc --noEmit",
    "version-packages": "changeset version"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.3",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-plugin-react-doctor": "0.9.14",
    "oxlint-tsgolint": "7.0.2003",
    "publint": "0.3.24",
    "react": "19.3.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.2"
}
